{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  timezone: "Europe/Amsterdam",
  schedule: ["before 9am on monday"],
  customManagers: [
    {
      // ci-runner images in the workflows, with or without a digest.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: ["(?<depName>ghcr\\.io/twanvanparidon/ci-runner/[a-z0-9-]+):(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      datasourceTemplate: "docker",
      versioningTemplate: "semver",
    },
    {
      // debian-base releases for the pve-prod templates. The new version goes
      // on top and the old ones stay below it; tofu keeps the first 3.
      customType: "regex",
      managerFilePatterns: ["/^tofu/stacks/pve-prod/templates\\.tf$/"],
      matchStrings: ["debian_base_versions = \\[\\n\\s*\"(?<currentValue>\\d{8}(?:\\.\\d+)?)\","],
      autoReplaceStringTemplate: "debian_base_versions = [\n    \"{{{newValue}}}\",\n    \"{{{currentValue}}}\",",
      depNameTemplate: "debian-base",
      packageNameTemplate: "twanvanparidon/infra",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^debian-base-(?<version>\\d{8}(?:\\.\\d+)?)$",
      versioningTemplate: "regex:^(?<major>\\d{8})(?:\\.(?<minor>\\d+))?$",
    },
    {
      // The Talos version of the image factory image in pve-prod.
      customType: "regex",
      managerFilePatterns: ["/^tofu/stacks/pve-prod/talos\\.tf$/"],
      matchStrings: ["talos_version = \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "siderolabs/talos",
      datasourceTemplate: "github-releases",
    },
  ],
  packageRules: [
    {
      // The custom manager above owns these pins; don't update them twice.
      matchManagers: ["github-actions"],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/twanvanparidon/ci-runner/**"],
      enabled: false,
    },
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      groupName: "github actions",
    },
    {
      matchManagers: ["devbox"],
      groupName: "devbox",
    },
    {
      // Our own CI images: one PR for all of them, at any time.
      matchPackageNames: ["ghcr.io/twanvanparidon/ci-runner/**"],
      groupName: "ci-runner images",
      schedule: ["at any time"],
    },
  ],
}
