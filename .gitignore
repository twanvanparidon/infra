# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.agekey

# OpenTofu
# State is committed (encrypted).
.terraform/
*.tfplan
*.tfstate.backup
.terraform.tfstate.lock.info
crash.log
crash.*.log
# Shared config and modules are only validated, never applied; stacks lock providers.
tofu/shared/.terraform.lock.hcl
tofu/modules/*/.terraform.lock.hcl

# Packer
packer_cache/
output-*/

# Ansible
*.retry
.ansible/

